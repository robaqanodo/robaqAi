# Live rooms: production uses same-origin /api/rooms with Upstash Redis
# (same KV as MovieSync). Leave VITE_ROOMS_SERVER_URL unset for that path.
# Optional dedicated process instead of Vercel:
# VITE_ROOMS_SERVER_URL=https://your-owned-room-service.example
# ROBAQ_APP_ORIGIN=https://www.robaq.app
# PORT=8790

# Server-only Gemini key for Default (web) chat. Never expose this to the client.
GEMINI_API_KEY=
